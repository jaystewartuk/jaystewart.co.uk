---
import { countedAt, resolve } from '../lib/metrics.ts';

interface Props {
  metrics: { label: string; from?: string; value?: string | number }[];
  /** Renders the provenance line. On by default — the point is the provenance. */
  showProvenance?: boolean;
  class?: string;
}

const { metrics, showProvenance = true, class: className = '' } = Astro.props;
const resolved = metrics.map(resolve);
---

{
  resolved.length > 0 && (
    <div class={className}>
      {/* A description list, not a grid of divs: each figure is a value with a
          name, and that is exactly what dl/dt/dd describes to a screen reader. */}
      <dl class="grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4">
        {resolved.map(({ label, value }) => (
          // `dt` precedes its `dd` in the DOM, as the spec requires, and
          // `order` puts the figure above the label visually.
          //
          // Not `flex-col-reverse`, which was the previous way of doing this:
          // reversing the column also moves the packing edge to the bottom, so
          // each cell's contents sat on the floor of a row stretched to its
          // tallest sibling. A label that wrapped to two lines pushed its own
          // figure up by a line and left every one-line neighbour behind — on
          // the flagship case study, "Decision records" fitted on one line and
          // its 204 hung a line below the 2,694 beside it. Ordering instead
          // keeps the packing edge at the top, so the figures — the thing the
          // eye scans across — share a baseline and the labels hang below.
          <div class="flex flex-col">
            <dt class="order-2 mt-1 text-sm text-muted">{label}</dt>
            <dd class="order-1 font-mono text-2xl font-medium tabular-nums sm:text-[1.75rem]">
              {value}
            </dd>
          </div>
        ))}
      </dl>

      {showProvenance && (
        <p class="mt-6 text-xs text-muted">
          Counted from the source repository on <time datetime={countedAt}>{countedAt}</time>,
          not estimated.
        </p>
      )}
    </div>
  )
}
